# Copiar a .env; sustituir antes de iniciar. Nunca versionar .env.
POSTGRES_DB=alinea
POSTGRES_USER=alinea
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_SECRET
WEB_PORT=8080
# Generar valores aleatorios privados con infra/init-auth-env.ps1; no usar placeholders.
# OTP_KEY y DEV_SMS_INBOX_KEY se añaden mediante el script, sin mostrarlos.
SMS_PROVIDER=Disabled
# Brevo: mantener Disabled y el bloqueo false hasta autorización expresa de envío.
# BREVO_API_KEY se carga desde un secreto externo; nunca incluir su valor aquí.
BREVO_SMS_SENDING_ENABLED=false
BREVO_SMS_SENDER_ID=
BREVO_SMS_TIMEOUT_SECONDS=3
# Solo Compose local enlazado a loopback. Producción exige HTTPS y false.
APP_ENVIRONMENT=Development
AUTH_LOCAL_HTTP=true
